#!/usr/bin/env bash
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0
protocol=""; host=""; path=""
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
    path) path="${value%.git}" ;;
  esac
done

[[ "$protocol" == "https" && "$host" == "github.com" ]] || exit 0
[[ -n "${SEO_GITHUB_PATH:-}" && "$path" == "$SEO_GITHUB_PATH" ]] || exit 0
[[ -n "${GH_TOKEN:-}" ]] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$GH_TOKEN"
